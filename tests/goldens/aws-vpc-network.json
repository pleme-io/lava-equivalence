{
  "resource": {
    "aws_eip": {
      "main-nat-eip": {
        "domain": "vpc",
        "tags": {
          "Name": "main-nat-eip"
        }
      }
    },
    "aws_internet_gateway": {
      "main-igw": {
        "tags": {
          "Name": "main-igw"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      }
    },
    "aws_nat_gateway": {
      "main-nat": {
        "allocation_id": "${aws_eip.main-nat-eip.allocation_id}",
        "subnet_id": "${aws_subnet.main-public-0.id}",
        "tags": {
          "Name": "main-nat"
        }
      }
    },
    "aws_security_group": {
      "main-default-sg": {
        "description": "Default security group for main VPC",
        "name_prefix": "main-default-",
        "tags": {
          "Name": "main-default-sg"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      }
    },
    "aws_subnet": {
      "main-private-0": {
        "availability_zone": "us-east-1a",
        "cidr_block": "10.0.10.0/24",
        "tags": {
          "Name": "main-private-us-east-1a",
          "Tier": "private"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      },
      "main-private-1": {
        "availability_zone": "us-east-1b",
        "cidr_block": "10.0.11.0/24",
        "tags": {
          "Name": "main-private-us-east-1b",
          "Tier": "private"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      },
      "main-private-2": {
        "availability_zone": "us-east-1c",
        "cidr_block": "10.0.12.0/24",
        "tags": {
          "Name": "main-private-us-east-1c",
          "Tier": "private"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      },
      "main-public-0": {
        "availability_zone": "us-east-1a",
        "cidr_block": "10.0.0.0/24",
        "map_public_ip_on_launch": true,
        "tags": {
          "Name": "main-public-us-east-1a",
          "Tier": "public"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      },
      "main-public-1": {
        "availability_zone": "us-east-1b",
        "cidr_block": "10.0.1.0/24",
        "map_public_ip_on_launch": true,
        "tags": {
          "Name": "main-public-us-east-1b",
          "Tier": "public"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      },
      "main-public-2": {
        "availability_zone": "us-east-1c",
        "cidr_block": "10.0.2.0/24",
        "map_public_ip_on_launch": true,
        "tags": {
          "Name": "main-public-us-east-1c",
          "Tier": "public"
        },
        "vpc_id": "${aws_vpc.main-vpc.id}"
      }
    },
    "aws_vpc": {
      "main-vpc": {
        "cidr_block": "10.0.0.0/16",
        "enable_dns_hostnames": true,
        "enable_dns_support": true,
        "tags": {
          "Environment": "production",
          "Name": "main-vpc"
        }
      }
    }
  }
}