{
  "resource": {
    "akeyless_auth_method_api_key": {
      "prod-ci-auth": {
        "bound_ips": [
          "10.0.0.0/8"
        ],
        "name": "/prod/ci-auth"
      }
    },
    "akeyless_auth_method_k8s": {
      "prod-k8s-auth": {
        "bound_namespaces": [
          "default"
        ],
        "name": "/prod/k8s-auth"
      }
    },
    "akeyless_role": {
      "prod-app-role": {
        "description": "Application role for prod environment",
        "name": "/prod/roles/app"
      }
    },
    "akeyless_static_secret": {
      "prod-api-key": {
        "description": "External service API key",
        "name": "/prod/service/api-key",
        "value": "change-me"
      },
      "prod-db-password": {
        "description": "Primary database password",
        "name": "/prod/database/password",
        "value": "change-me"
      }
    },
    "akeyless_target_db": {
      "prod-db-target": {
        "connection_type": "regular",
        "db_name": "production",
        "db_type": "postgres",
        "host": "db.example.com",
        "name": "/prod/targets/postgres",
        "port": "5432",
        "pwd": "admin-password",
        "user_name": "admin"
      }
    }
  }
}